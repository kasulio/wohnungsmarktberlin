{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "start": "bun .output/server/index.mjs",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun server/db/migrate.ts",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "seed:admin": "bun --bun scripts/seed-admin-auth.ts",
    "scrape:canary": "bun --bun scripts/scraper-canary.ts",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "bun test",
    "postinstall": "bun --bun nuxt prepare && (lefthook install >/dev/null 2>&1 || true)",
    "check": "bun fmt --check && bun lint && bun typecheck && bun test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@nuxt/image": "^2.2.1",
    "@t3-oss/env-nuxt": "^0.13.11",
    "@trpc/client": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "better-auth": "~1.6.35",
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "effect": "4.1.4",
    "grammy": "^1.46.0",
    "lottie-web": "^5.13.0",
    "node-html-parser": "^7.1.0",
    "sharp": "^0.34.5",
    "trpc-nuxt": "^0.10.17",
    "vue-chartjs": "^5.3.7",
    "vue3-google-map": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/icon": "2.3.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/sitemap": "^8.6.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.5",
    "@unhead/vue": "^2.1.18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "lefthook": "^2.2.2",
    "nuxt": "^4.6.4",
    "nuxt-ipx-cache": "1.0.8",
    "typescript": "^6.0.3",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001803",
    "esbuild": "^0.25.0",
    "sharp": "0.34.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lefthook",
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "bun": ">=1.4.4"
  }
}
